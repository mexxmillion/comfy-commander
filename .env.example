APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
# Docker Compose supplies persistent SQLite and credential paths.
# For a host install, defaults live under state/ and the per-user data directory.
# DATABASE_URL=sqlite:///state/dispatcher.sqlite3
# TENSOR_MASTER_CREDENTIAL_DIR=C:/private/tensor-master/credentials

# Cloud safety limits.
MAX_ACTIVE_GPUS=2
MAX_GPU_PRICE_PER_HOUR=1.25
MAX_TOTAL_PRICE_PER_HOUR=2.00
MAX_INSTANCE_LIFETIME_HOURS=6
IDLE_DESTROY_MINUTES=15
