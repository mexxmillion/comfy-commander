 logger = logging.getLogger("LTXVideo.hdr_nodes")
 
+
+def _no_tiled_vae(*args, **kwargs):
+    raise RuntimeError("Full-frame LTX VAE ran out of memory; tiled fallback is disabled. Use a shorter clip or more memory.")
+
+
+@comfy_node(name="LTXVUntiledVAE")
+class LTXVUntiledVAE:
+    """Keep VAE memory fallback from silently splitting a full-frame recipe."""
+    @classmethod
+    def INPUT_TYPES(cls):
+        return {"required": {"vae": ("VAE",)}}
+
+    RETURN_TYPES = ("VAE",)
+    FUNCTION = "apply"
+    CATEGORY = "Lightricks/HDR"
+
+    def apply(self, vae):
+        result = copy.copy(vae)
+        result.encode_tiled = _no_tiled_vae
+        result.encode_tiled_3d = _no_tiled_vae
+        result._encode_tiled_owned = _no_tiled_vae
+        result.decode_tiled = _no_tiled_vae
+        result.decode_tiled_3d = _no_tiled_vae
+        result._decode_tiled_owned = _no_tiled_vae
+        return (result,)
+
